# For Docker Compose. Choose a URL-safe password and use the same value in DATABASE_URL.
POSTGRES_PASSWORD=ritm_local_change_me
DATABASE_URL=postgresql://ritm:ritm_local_change_me@db:5432/ritm?schema=public

# Generate AUTH_SECRET with node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
WEB_PORT=3000

# Optional SMTP for password recovery. Use your provider's authorized sender.
SMTP_URL=
SMTP_FROM=

# Optional Web Push. Generate the pair with npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
